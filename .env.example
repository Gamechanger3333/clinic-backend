DATABASE_URL="postgresql://user:password@localhost:5432/clinicflow"

# JWT Secrets - use long random strings (min 32 chars each)
ACCESS_TOKEN_SECRET="change-this-access-token-secret-min-32-chars-long"
REFRESH_TOKEN_SECRET="change-this-refresh-token-secret-min-32-chars-long"

# Token expiry
ACCESS_TOKEN_EXPIRES_IN="15m"
REFRESH_TOKEN_EXPIRES_IN="7d"

PORT=3001
NODE_ENV=development

# CORS
FRONTEND_URL="http://localhost:3000"

# Groq AI (https://console.groq.com/keys) — powers the in-app + landing page AI assistant
GROQ_API_KEY="gsk_your_groq_api_key_here"
GROQ_MODEL="openai/gpt-oss-120b"

# Demo account — lets anyone log in instantly (no signup/verification) as a
# read-mostly patient via the "Try Demo Account" button on the login page.
# Its data resets automatically on every demo login (see src/lib/demo.ts).
# Change these if you don't want the default credentials publicly known.
DEMO_USER_EMAIL="demo@clinicflow.com"
DEMO_USER_PASSWORD="Demo@1234"
